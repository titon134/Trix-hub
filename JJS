-- Auto Black Flash Loop (Hooks namecall to detect remote firing)
task.spawn(function()
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LocalPlayer = Players.LocalPlayer
    
    local debounce = false
    local cancelNextDF = false
    local pendingDF = false
    
    -- Monitor for RightActivated every 0.01 seconds
    task.spawn(function()
        while true do
            task.wait(0.01)
            
            if pendingDF then
                -- Check if RightActivated was used
                pcall(function()
                    local itadoriService = ReplicatedStorage.Knit.Knit.Services.ItadoriService
                    if itadoriService then
                        local re = itadoriService.RE
                        if re then
                            local rightActivated = re.RightActivated
                            if rightActivated then
                                -- If we detect any activity on RightActivated, cancel the pending DF
                                -- This check happens every 0.01 seconds while DF is pending
                            end
                        end
                    end
                end)
            end
        end
    end)
    
    -- Hook into namecall to detect when remotes are fired
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        
        -- Check if RightActivated is being fired - cancel pending Divergent Fist
        if method == "FireServer" and self.Name == "RightActivated" then
            local parent = self.Parent
            if parent and parent.Name == "RE" then
                local service = parent.Parent
                if service and service.Name == "ItadoriService" then
                    -- RightActivated detected! Cancel the pending Divergent Fist
                    if pendingDF then
                        cancelNextDF = true
                        pendingDF = false
                        print("Cancelled pending Divergent Fist due to RightActivated")
                    end
                end
            end
        end
        
        -- Check if it's a FireServer call to the Divergent Fist remote
        if method == "FireServer" and self.Name == "Activated" then
            local parent = self.Parent
            if parent and parent.Name == "RE" then
                local service = parent.Parent
                if service and service.Name == "DivergentFistService" then
                    -- Detected Divergent Fist being used!
                    if ABFY and not debounce then
                        debounce = true
                        pendingDF = true
                        cancelNextDF = false
                        
                        -- Fire again after 0.31 seconds (unless cancelled)
                        task.spawn(function()
                            task.wait(0.31)
                            
                            if ABFY and not cancelNextDF then
                                pcall(function()
                                    local character = LocalPlayer.Character
                                    if character then
                                        local moveset = character:FindFirstChild("Moveset")
                                        if moveset then
                                            local divergentFist = moveset:FindFirstChild("Divergent Fist")
                                            if divergentFist then
                                                local newArgs = {divergentFist}
                                                ReplicatedStorage.Knit.Knit.Services.DivergentFistService.RE.Activated:FireServer(unpack(newArgs))
                                                print("Auto Black Flash executed!")
                                            end
                                        end
                                    end
                                end)
                            elseif cancelNextDF then
                                print("Auto Black Flash cancelled")
                            end
                            
                            pendingDF = false
                            cancelNextDF = false
                            task.wait(0.2)
                            debounce = false
                        end)
                    end
                end
            end
        end
        
        return oldNamecall(self, ...)
    end)
    
    print("Auto Black Flash active! Use Divergent Fist and it will auto-fire after 0.31s")
    print("RightActivated will cancel pending Divergent Fist")
end)
