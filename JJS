-- Global variable for toggle state
local ABFY = false
local AutoExecute = true

-- Auto Execute functionality
local function setupAutoExecute()
    if AutoExecute then
        -- Save the script source to execute on rejoin
        local scriptSource = game:HttpGet("https://raw.githubusercontent.com/yourusername/yourscript.lua") -- Replace with your actual script URL
        
        -- Detect when player teleports to new place
        game:GetService("Players").LocalPlayer.OnTeleport:Connect(function(State)
            if State == Enum.TeleportState.Started then
                -- Check if it's a Jujutsu Shenanigans game
                local success, placeName = pcall(function()
                    return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
                end)
                
                if success and placeName and string.find(string.lower(placeName), "jujutsu") and string.find(string.lower(placeName), "shenanigan") then
                    -- Queue script to execute on teleport
                    queue_on_teleport([[
                        repeat task.wait() until game:IsLoaded()
                        loadstring(game:HttpGet("https://raw.githubusercontent.com/yourusername/yourscript.lua"))()
                    ]])
                end
            end
        end)
        
        print("Auto Execute enabled - will re-execute on Jujutsu Shenanigans server joins")
    end
end

