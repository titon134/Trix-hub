-- Variables
local logs = {}
local selectedLogs = {}
local currentFilter = "All"
local logCounts = {Debug = 0, Info = 0, Warning = 0, Error = 0}

-- Functions
local function getLogColor(logType)
    	if logType == "Error" then
        		return Color3.fromRGB(255, 100, 100)
    	elseif logType == "Warning" then
        		return Color3.fromRGB(255, 200, 100)
    	elseif logType == "Info" then
        		return Color3.fromRGB(100, 150, 255)
    	elseif logType == "Debug" then
        		return Color3.fromRGB(100, 255, 150)
    	end
    	return Color3.fromRGB(200, 200, 200)
end

local function updateStats()
    	local selectedCount = 0
    	for _ in pairs(selectedLogs) do
        		selectedCount = selectedCount + 1
    	end
    	
    	if selectedCount > 0 then
        		statsLabel.Text = string.format("%d selected | Debug: %d | Info: %d | Warning: %d | Error: %d",
        			selectedCount, logCounts.Debug, logCounts.Info, logCounts.Warning, logCounts.Error)
    	else
        		statsLabel.Text = string.format("Debug: %d | Info: %d | Warning: %d | Error: %d",
        			logCounts.Debug, logCounts.Info, logCounts.Warning, logCounts.Error)
    	end
end

local function updateCopyButton()
    	local selectedCount = 0
    	for _ in pairs(selectedLogs) do
        		selectedCount = selectedCount + 1
    	end
    	
    	if selectedCount > 0 then
        		copyButton.Text = "Copy Selected"
    	else
        		copyButton.Text = "Copy All Debug"
    	end
end

local function createLogEntry(message, logType, timestamp)
    	local logEntry = Instance.new("Frame")
    	logEntry.Name = "LogEntry"
    	logEntry.Size = UDim2.new(1, -10, 0, 30)
    	logEntry.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    	logEntry.BorderSizePixel = 0
    	logEntry.Parent = consoleFrame
    	
    	local logCorner = Instance.new("UICorner")
    	logCorner.CornerRadius = UDim.new(0, 4)
    	logCorner.Parent = logEntry
    	
    	local logButton = Instance.new("TextButton")
    	logButton.Size = UDim2.new(1, 0, 1, 0)
    	logButton.BackgroundTransparency = 1
    	logButton.Text = ""
    	logButton.Parent = logEntry
    	
    	local timeLabel = Instance.new("TextLabel")
    	timeLabel.Size = UDim2.new(0, 60, 1, 0)
    	timeLabel.Position = UDim2.new(0, 5, 0, 0)
    	timeLabel.BackgroundTransparency = 1
    	timeLabel.Text = timestamp
    	timeLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    	timeLabel.TextSize = 10
    	timeLabel.Font = Enum.Font.Code
    	timeLabel.TextXAlignment = Enum.TextXAlignment.Left
    	timeLabel.Parent = logEntry
    	
    	local typeLabel = Instance.new("TextLabel")
    	typeLabel.Size = UDim2.new(0, 60, 1, 0)
    	typeLabel.Position = UDim2.new(0, 70, 0, 0)
    	typeLabel.BackgroundTransparency = 1
    	typeLabel.Text = string.upper(logType)
    	typeLabel.TextColor3 = getLogColor(logType)
    	typeLabel.TextSize = 10
    	typeLabel.Font = Enum.Font.GothamBold
    	typeLabel.TextXAlignment = Enum.TextXAlignment.Left
    	typeLabel.Parent = logEntry
    	
    	local messageLabel = Instance.new("TextLabel")
    	messageLabel.Size = UDim2.new(1, -140, 1, 0)
    	messageLabel.Position = UDim2.new(0, 135, 0, 0)
    	messageLabel.BackgroundTransparency = 1
    	messageLabel.Text = message
    	messageLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    	messageLabel.TextSize = 11
    	messageLabel.Font = Enum.Font.Code
    	messageLabel.TextXAlignment = Enum.TextXAlignment.Left
    	messageLabel.TextTruncate = Enum.TextTruncate.AtEnd
    	messageLabel.Parent = logEntry
    	
    	local logData = {
        		frame = logEntry,
        		message = message,
        		type = logType,
        		timestamp = timestamp,
        		id = #logs + 1
    	}
    	
    	table.insert(logs, logData)
    	
    	logButton.MouseButton1Click:Connect(function()
        		if selectedLogs[logData.id] then
            			selectedLogs[logData.id] = nil
            			logEntry.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        		else
            			selectedLogs[logData.id] = logData
            			logEntry.BackgroundColor3 = Color3.fromRGB(60, 100, 180)
        		end
        		updateCopyButton()
        		updateStats()
    	end)
    	
    	consoleFrame.CanvasSize = UDim2.new(0, 0, 0, consoleLayout.AbsoluteContentSize.Y)
    	
    	return logData
end

local function addLog(message, logType)
    	local timestamp = os.date("%H:%M:%S")
    	logCounts[logType] = logCounts[logType] + 1
    	
    	local logData = createLogEntry(message, logType, timestamp)
    	
    	if currentFilter == "All" or currentFilter == logType then
        		logData.frame.Visible = true
    	else
        		logData.frame.Visible = false
    	end
    	
    	updateStats()
    	consoleFrame.CanvasPosition = Vector2.new(0, consoleLayout.AbsoluteContentSize.Y)
end

local function applyFilter(filterType)
    	currentFilter = filterType
    	filterButton.Text = "Filter: " .. filterType
    	
    	for _, logData in ipairs(logs) do
        		if filterType == "All" or logData.type == filterType then
            			logData.frame.Visible = true
        		else
            			logData.frame.Visible = false
        		end
    	end
    	
    	consoleFrame.CanvasSize = UDim2.new(0, 0, 0, consoleLayout.AbsoluteContentSize.Y)
end

-- Toggle Console
toggleButton.MouseButton1Click:Connect(function()
    	mainFrame.Visible = not mainFrame.Visible
    	toggleButton.Text = mainFrame.Visible and "<" or ">"
end)

-- Copy Button
copyButton.MouseButton1Click:Connect(function()
    	local textToCopy = ""
    	local hasSelected = false
    	
    	for _ in pairs(selectedLogs) do
        		hasSelected = true
        		break
    	end
    	
    	if hasSelected then
        		for _, logData in pairs(selectedLogs) do
            			textToCopy = textToCopy .. string.format("[%s] [%s] %s\n", logData.timestamp, string.upper(logData.type), logData.message)
        		end
    	else
        		for _, logData in ipairs(logs) do
            			if logData.type == "Debug" then
                				textToCopy = textToCopy .. string.format("[%s] [%s] %s\n", logData.timestamp, string.upper(logData.type), logData.message)
            			end
        		end
    	end
    	
    	setclipboard(textToCopy)
    	copyButton.Text = "Copied!"
    	wait(2)
    	updateCopyButton()
end)

-- Filter Button
filterButton.MouseButton1Click:Connect(function()
    	filterDropdown.Visible = not filterDropdown.Visible
end)

-- Filter Options
for _, child in ipairs(filterDropdown:GetChildren()) do
    	if child:IsA("TextButton") then
        		child.MouseButton1Click:Connect(function()
            			applyFilter(child.Name)
            			filterDropdown.Visible = false
        		end)
    	end
end

-- Clear All Button
clearButton.MouseButton1Click:Connect(function()
    	for _, logData in ipairs(logs) do
        		logData.frame:Destroy()
    	end
    	logs = {}
    	selectedLogs = {}
    	logCounts = {Debug = 0, Info = 0, Warning = 0, Error = 0}
    	updateStats()
    	updateCopyButton()
    	consoleFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
end)

-- Listen to LogService
LogService.MessageOut:Connect(function(message, messageType)
    	if messageType == Enum.MessageType.MessageError then
        		addLog(message, "Error")
    	elseif messageType == Enum.MessageType.MessageWarning then
        		addLog(message, "Warning")
    	elseif messageType == Enum.MessageType.MessageInfo then
        		addLog(message, "Info")
    	else
        		addLog(message, "Debug")
    	end
end)

